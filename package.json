{
  "name": "observatorio-aguas-lindas",
  "private": true,
  "version": "45.0.5",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
