{
  "name": "observatorio-aguas-lindas",
  "private": true,
  "version": "46.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "quality:check": "npm run typecheck && npm run audit:static && npm run audit:a11y && npm run audit:mobile && npm run audit:municipal",
    "audit:static": "node scripts/audit-static.mjs",
    "audit:a11y": "node scripts/audit-accessibility.mjs",
    "validate:observatorio": "node scripts/validate-observatorio.mjs",
    "test:pwa": "node scripts/test-service-worker.mjs",
    "audit:mobile": "node scripts/audit-mobile.mjs",
    "audit:usability": "node scripts/audit-usability.mjs",
    "audit:sources": "node scripts/audit-sources.mjs",
    "test:source-audit-policy": "node scripts/test-source-audit-policy.mjs",
    "audit:runtime": "node scripts/audit-runtime.mjs",
    "audit:engagement": "node scripts/audit-engagement.mjs",
    "audit:quiz": "node scripts/audit-quiz.mjs",
    "audit:public-services": "node --check scripts/audit-public-services.mjs && node scripts/audit-public-services.mjs",
    "test:browser": "playwright test --config=playwright.config.mjs",
    "audit:deps": "npm audit --audit-level=high",
    "audit:bundle": "node scripts/audit-bundle.mjs",
    "audit:release": "node scripts/audit-release.mjs",
    "test:audit-guards": "node scripts/test-audit-guards.mjs",
    "check:main-provenance": "node scripts/assert-main-provenance.mjs",
    "audit:workflows": "node scripts/audit-workflows.mjs",
    "audit:styles": "node scripts/audit-styles.mjs",
    "audit:performance": "node scripts/audit-performance.mjs",
    "cleanup:branches": "node scripts/cleanup-branches.mjs",
    "audit:provenance": "node scripts/audit-provenance.mjs",
    "test:branch-cleanup": "node scripts/test-branch-cleanup.mjs",
    "audit:municipal": "node scripts/audit-municipal.mjs"
  },
  "dependencies": {
    "@sentry/react": "11.1.0",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0"
  }
}
