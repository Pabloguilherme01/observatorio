{
  "name": "observatorio-aguas-lindas",
  "private": true,
  "version": "44.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "audit:static": "node scripts/audit-static.mjs",
    "audit:a11y": "node scripts/audit-accessibility.mjs",
    "sync:tse": "node scripts/sync-tse-2026.mjs",
    "validate:tse": "node scripts/validate-tse-2026.mjs",
    "validate:observatorio": "node scripts/validate-observatorio.mjs",
    "validate:results": "node scripts/validate-results-feed.mjs",
    "verify:jws": "node scripts/verify-jws.mjs",
    "sync:results": "node scripts/sync-results-2026.mjs",
    "test:jws": "node scripts/test-jws-verifier.mjs",
    "audit:mobile": "node scripts/audit-mobile.mjs",
    "audit:tse-architecture": "node scripts/audit-tse-architecture.mjs",
    "audit:usability": "node scripts/audit-usability.mjs",
    "audit:sources": "node scripts/audit-sources.mjs",
    "ingest:tse:contas": "node --experimental-strip-types scripts/tse/ingest-contas.ts",
    "ingest:tse:pesquisas": "node --experimental-strip-types scripts/tse/ingest-pesquisas.ts",
    "ingest:tse:processual": "node --experimental-strip-types scripts/tse/ingest-processual.ts",
    "ingest:tse:all": "npm run ingest:tse:contas && npm run ingest:tse:pesquisas && npm run ingest:tse:processual",
    "test:e2e": "playwright test tests/e2e/observatorio.spec.ts",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:visual": "playwright test tests/visual/visual.spec.ts",
    "ingest:tse:first-batch": "node --experimental-strip-types scripts/tse/ingest-first-batch.ts",
    "verify:tse:capture": "node --experimental-strip-types scripts/tse/verify-capture.ts",
    "report:axe": "node scripts/build-axe-report.mjs",
    "test:snapshot-diff": "node scripts/test-snapshot-diff.mjs",
    "diagnose:tse:matching": "node --experimental-strip-types scripts/tse/diagnose-matching.ts",
    "ingest:tse:candidates-local": "node --experimental-strip-types scripts/tse/ingest-candidates-local.ts"
  },
  "dependencies": {
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "@types/react": "19.1.14",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0"
  }
}
