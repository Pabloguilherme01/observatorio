{
  "openapi": "3.0.3",
  "info": {
    "title": "Observatório Águas Lindas — API pública",
    "version": "43.2.0",
    "description": "Snapshot público estático gerado a cada build a partir da mesma fonte usada pela interface."
  },
  "servers": [
    {
      "url": "/observatorio"
    }
  ],
  "paths": {
    "/api/v1/observatorio.json": {
      "get": {
        "summary": "Dataset consolidado da edição publicada",
        "responses": {
          "200": {
            "description": "JSON do observatório"
          }
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "summary": "Especificação OpenAPI",
        "responses": {
          "200": {
            "description": "OpenAPI JSON"
          }
        }
      }
    },
    "/api/v1/health.json": {
      "get": {
        "summary": "Estado do build publicado",
        "responses": {
          "200": {
            "description": "Metadados do build e dataset"
          }
        }
      }
    },
    "/api/v1/sources.json": {
      "get": {
        "summary": "Registro de fontes do observatório",
        "responses": {
          "200": {
            "description": "Fontes e metadados de referência"
          }
        }
      }
    }
  }
}